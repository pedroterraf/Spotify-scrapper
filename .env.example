# Copy this file to .env and fill in real values. .env is gitignored — never commit real tokens.
#
# How to get them:
#   1. Open open.spotify.com and log in
#   2. Open DevTools (F12) -> Network tab
#   3. Play/browse an album and look for a request to api-partner.spotify.com
#   4. Copy the "authorization: Bearer ..." and "client-token: ..." header values below
#
# These are short-lived session tokens tied to your own logged-in browser session — they expire.

SPOTIFY_TOKEN=
CLIENT_TOKEN=
